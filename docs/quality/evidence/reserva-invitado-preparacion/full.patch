+if (!priorApi.includes(`${path.sep}.tmp${path.sep}m2-c3-p1${path.sep}`))
+  throw new Error('Compatibilidad exige copia aislada del API anterior');
+const ids = JSON.parse(process.env.P1_FIXTURE);
