{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H localhost -p 3001",
    "build": "next build",
    "start": "next start -H localhost -p 3001",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "type-check:clean": "node scripts/clean-generated-types.mjs && next typegen && tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:components",
    "test:unit": "node --test lib/*.test.ts",
    "test:components": "vitest run",
    "test:browser": "playwright test",
    "test:auth-routes": "node --test lib/auth-routes.test.ts lib/invitation-navigation.test.ts",
    "test:dashboard-scope": "node --test lib/dashboard-summary-state.test.ts",
    "test:invoices": "node --test lib/invoice-ui.test.ts"
  },
  "dependencies": {
    "@clerk/localizations": "^4.15.5",
    "@clerk/nextjs": "^7.8.0",
    "@tanstack/react-query": "^5.62.0",
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
