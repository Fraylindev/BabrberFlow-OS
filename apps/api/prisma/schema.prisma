generator client {
  provider = "prisma-client-js"
}

enum BusinessScheduleState {
  UNCONFIRMED
  LEGACY_UNCONFIRMED
  CONFIRMED
}

model BusinessSchedule {
  organizationId      String @id
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  revision            Int @default(0)
  state               BusinessScheduleState @default(UNCONFIRMED)
  zoneConfirmed       Boolean @default(false)
  legacyCategory      String?
  legacyOriginal      Json?
  legacyPublicAllowed Boolean @default(false)
  days                BusinessScheduleDay[]
  closures            BusinessClosure[]
  revisions           BusinessScheduleRevision[]
}

model BusinessScheduleDay {
  organizationId String
  dayOfWeek      Int
  schedule       BusinessSchedule @relation(fields: [organizationId], references: [organizationId], onDelete: Restrict)
  windows        BusinessScheduleWindow[]

  @@id([organizationId, dayOfWeek])
}

model BusinessScheduleWindow {
  id             String @id @default(uuid())
  organizationId String
  dayOfWeek      Int
  startMinute    Int
  endMinute      Int
  day            BusinessScheduleDay @relation(fields: [organizationId, dayOfWeek], references: [organizationId, dayOfWeek], onDelete: Restrict, map: "BusinessScheduleWindow_day_fkey")

  @@index([organizationId, dayOfWeek, startMinute])
}

model BusinessClosure {
  id             String @id @default(uuid())
  organizationId String
  schedule       BusinessSchedule @relation(fields: [organizationId], references: [organizationId], onDelete: Restrict)
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  startMinute    Int
  endMinute      Int
  status         AvailabilityBlockStatus @default(ACTIVE)
  reason         String? @db.VarChar(500)
  createdAt      DateTime @default(now())
  cancelledAt    DateTime?

  @@unique([id, organizationId])
  @@index([organizationId, status, startDate, endDate])
}

model BusinessScheduleRevision {
  organizationId String
  revision       Int
  schedule       BusinessSchedule @relation(fields: [organizationId], references: [organizationId], onDelete: Restrict)
  actorUserId    String
  operation      String
  snapshot       Json
  createdAt      DateTime @default(now())

  @@id([organizationId, revision])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// HTTP/security budget shared by API replicas; separate from EmailAbuseBucket.
// key is an HMAC digest, never a raw IP, email or token.
model SecurityRateBucket {
  key          String   @id
  count        Int
  expiresAt    DateTime @db.Timestamptz(6)
  blockedUntil DateTime? @db.Timestamptz(6)

  @@index([expiresAt])
}

enum UserRole {
  // B2B — personal interno con acceso al panel de gestión
  OWNER
  ADMIN
  BARBER
  RECEPTIONIST

  // B2C — clientes finales, creados solo desde el flujo público de reservas
  CUSTOMER
}

enum TeamInvitationStatus {
  CREATING
  PENDING
  RESENDING
  REVOKING
  ACCEPTED
  REVOKED
  EXPIRED
  FAILED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ProfessionalStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AvailabilityBlockStatus {
  ACTIVE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum MediaAssetPurpose {
  GALLERY
  SERVICE
  PROFESSIONAL_AVATAR
  PROMOTION
}

enum MediaAssetStatus {
  STAGED
  APPROVED
  PUBLISHED
  QUARANTINED
  RETIRED
  PURGED
}

enum MediaModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Organization {
  id String @id @default(uuid())

  name String

  slug String @unique

  email String @unique

  phone String?

  address String?

  googleMapsUrl String?

  aboutUs String?

  heroImageUrl String?

  socialLinks Json?

  businessHours Json?

  timeZone String @default("America/Santo_Domingo")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  memberships Membership[]

  professionals Professional[]

  clients Client[]

  services Service[]

  galleryImages GalleryImage[]

  bookings Booking[]

  customerOperations             CustomerOperation[]
  payments                       Payment[]
  invoices                       Invoice[]
  professionalWeeklySchedules    ProfessionalWeeklySchedule[]
  professionalAvailabilityBlocks ProfessionalAvailabilityBlock[]
  teamInvitations                TeamInvitation[]
  cmsPage                        CmsPage?
  mediaAssets                    MediaAsset[]
  mediaPromotions                MediaPromotion[]
  mediaGalleryOrder              MediaGalleryOrder?
  mediaPurgeJobs                 MediaPurgeJob[]
    mediaOperations                MediaOperation[]
    businessSchedule               BusinessSchedule?
  }

// Custodia editorial independiente de GalleryImage legacy y CmsPage.
// targetId se valida siempre con organizationId en la misma transacción;
// nunca se interpreta como permiso ni URL del proveedor.
model MediaAsset {
  id                 String                @id @default(uuid())
  organizationId     String
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purpose            MediaAssetPurpose
  targetId           String?
  cloudAssetId       String?               @unique
  cloudPublicId      String?               @unique
  cloudVersion       Int?
  sha256             String
  bytes              Int
  width              Int
  height             Int
  status             MediaAssetStatus      @default(STAGED)
  moderationStatus   MediaModerationStatus @default(PENDING)
  revision           Int                   @default(1)
  publishedRevision  Int?
  altText            String
  caption            String?
  decorative         Boolean               @default(false)
  publishedAltText   String?
  publishedCaption   String?
  publishedDecorative Boolean?
  uploadedByUserId   String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  publishedAt        DateTime?
  quarantinedAt      DateTime?
  retiredAt          DateTime?
  purgedAt           DateTime?
  stagingExpiresAt   DateTime
  purgeAfter         DateTime?
  purgeJob           MediaPurgeJob?
  promotion          MediaPromotion?

  @@index([organizationId, status, purpose, targetId])
  @@index([organizationId, stagingExpiresAt])
  @@unique([organizationId, id])
}

// Revisión del orden totalmente separada de la revisión de cada imagen.
model MediaGalleryOrder {
  organizationId    String       @id
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  version           Int          @default(0)
  draftRevision     Int          @default(0)
  draftAssetIds     Json
  draftHeroAssetId  String?
  publishedRevision Int?
  publishedAssetIds Json?
  publishedHeroAssetId String?
  updatedAt         DateTime     @updatedAt
}

model MediaPromotion {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  version          Int          @default(0)
  draftRevision    Int          @default(1)
  draftTitle       String
  draftBody        String
  draftStartDate   String
  draftEndDate     String
  imageAssetId     String?      @unique
  imageAsset       MediaAsset?  @relation(fields: [organizationId, imageAssetId], references: [organizationId, id], onDelete: Restrict)
  publishedRevision Int?
  publishedTitle   String?
  publishedBody    String?
  publishedImageAssetId String?
  timeZone         String?
  startsAtUtc      DateTime?
  endsAtUtc        DateTime?
  isPublished      Boolean      @default(false)
  retiredAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, isPublished, startsAtUtc, endsAtUtc])
  @@unique([organizationId, imageAssetId])
}

// Trabajo durable de purga; un fallo del proveedor no reabre entrega pública.
model MediaPurgeJob {
  assetId        String     @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset          MediaAsset @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Restrict)
  attempts       Int        @default(0)
  nextAttemptAt  DateTime
  completedAt    DateTime?
  lastErrorCode  String?
  createdAt      DateTime   @default(now())

  @@index([nextAttemptAt, completedAt])
  @@index([organizationId, completedAt])
  @@unique([organizationId, assetId])
}

model MediaOperation {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorUserId    String
  key            String
  operation      String
  requestHash    String
  resourceId     String
  resultRevision Int
  result         Json
  createdAt      DateTime @default(now())

  @@id([organizationId, actorUserId, key])
  @@index([organizationId, resourceId])
}

// Agregado editorial independiente; Organization conserva identidad y operación.
model CmsPage {
  organizationId    String         @id
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  version           Int            @default(0)
  draftRevision     Int            @default(0)
  draft             Json
  publishedSnapshot Json?
  publishedRevision Int?
  isPublished       Boolean        @default(false)
  operations        CmsOperation[]
}

// Recibo sin contenido editorial ni PII. La clave se limita al tenant/actor.
model CmsOperation {
  organizationId    String
  page              CmsPage @relation(fields: [organizationId], references: [organizationId], onDelete: Restrict)
  actorUserId       String
  key               String
  operation         String
  requestHash       String
  version           Int
  publishedRevision Int?
  isPublished       Boolean

  @@id([organizationId, actorUserId, key])
}

// Identidad global: una cuenta puede pertenecer a varias organizaciones a
// través de Membership. El rol y la organización activa no viven aquí.
model User {
  id String @id @default(uuid())

  // Enlace externo Clerk nullable y único. Nunca se infiere por correo.
  clerkUserId String? @unique

  email String @unique

  password String?

  name String

  // Preferencia de organización; nunca concede acceso sin Membership.
  lastOrganizationId String?

  memberships Membership[]

  // Un User puede tener como máximo un Professional por organización,
  // y por tanto varios perfiles si pertenece a organizaciones distintas.
  professionals Professional[]

  sentTeamInvitations     TeamInvitation[] @relation("TeamInvitationInviter")
  acceptedTeamInvitations TeamInvitation[] @relation("TeamInvitationAcceptor")

  // Vínculo B2C explícito con registros Client. No concede Membership ni rol.
  clients Client[]
  customerOperations CustomerOperation[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

// Representa la pertenencia de un User a una Organization, con el rol que
// tiene ahí. Es la pieza que permite "un login, varias barberías, un rol
// distinto en cada una". Cascade hacia ambos padres a propósito: un
// Membership sin su User o sin su Organization no tiene ningún sentido
// (a diferencia de Booking/Invoice, que nunca se borran en cascada).
model Membership {
  id String @id @default(uuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role UserRole @default(BARBER)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
}

model TeamInvitation {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email               String
  role                UserRole
  createPublicProfile Boolean              @default(false)
  status              TeamInvitationStatus @default(CREATING)

  clerkInvitationId String? @unique

  invitedByUserId String
  invitedByUser   User   @relation("TeamInvitationInviter", fields: [invitedByUserId], references: [id])

  acceptedByUserId String?
  acceptedByUser   User?   @relation("TeamInvitationAcceptor", fields: [acceptedByUserId], references: [id])

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([organizationId, status, createdAt, id])
  @@index([organizationId, email])
}

model Professional {
  id String @id @default(uuid())

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  name String

  bio String?

  phone String?

  avatar String?

  specialty String?

  experienceYears Int?

  status ProfessionalStatus @default(INACTIVE)

  isPublic Boolean @default(false)

  // Vínculo opcional hacia el User que puede iniciar sesión como este
  // profesional (ej. un BARBER viendo su propia agenda). Un
  // Professional puede existir sin cuenta de acceso — no todos los
  // profesionales necesitan entrar al panel.
  userId String?

  user User? @relation(fields: [userId], references: [id])

  professionalServices ProfessionalService[]

  weeklySchedule ProfessionalWeeklySchedule[]

  availabilityBlocks ProfessionalAvailabilityBlock[]

  bookings Booking[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@unique([id, organizationId], map: "Professional_id_organizationId_key")
  @@index([organizationId, status, name, id])
}

model ProfessionalWeeklySchedule {
  id String @id @default(uuid())

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  professionalId String

  professional Professional @relation(fields: [professionalId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "ProfessionalWeeklySchedule_professionalId_fkey")

  dayOfWeek Int

  startMinute Int

  endMinute Int

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([organizationId, professionalId, dayOfWeek], map: "ProfessionalSchedule_org_prof_day_idx")
}

model ProfessionalAvailabilityBlock {
  id String @id @default(uuid())

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  professionalId String

  professional Professional @relation(fields: [professionalId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "ProfessionalAvailabilityBlock_professionalId_fkey")

  startTime DateTime

  endTime DateTime

  status AvailabilityBlockStatus @default(ACTIVE)

  note String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([organizationId, professionalId, status, startTime], map: "ProfessionalBlock_org_prof_status_start_idx")
  @@index([organizationId, professionalId, endTime], map: "ProfessionalBlock_org_prof_end_idx")
}

model GalleryImage {
  id String @id @default(uuid())

  organizationId String

  // Las fotos de la galería no tienen sentido sin su organización — si se
  // borra la organización, se borran con ella (a diferencia de datos
  // financieros como Booking/Invoice, que nunca deben desaparecer así).
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  url String

  caption String?

  order Int @default(0)

  createdAt DateTime @default(now())
}

model Client {
  id String @id @default(uuid())

  organizationId String

  // Identidad B2C opcional. El enlace requiere una sesión Clerk verificada y
  // nunca se infiere automáticamente por coincidencia de correo.
  userId String?

  organization Organization @relation(fields: [organizationId], references: [id])

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  name String

  email String?

  emailRevision    Int                      @default(0)
  emailPreferences BookingEmailPreference[]

  phone String?

  notes String?

  isActive Boolean @default(true)

  // D4: solo un claim válido habilita; un cambio de vínculo revoca el acceso.
  customerAccessBlocked    Boolean @default(true)
  // Cuarentena persistente por conflicto objetivo o mezcla confirmada; el claim no la borra.
  customerHistoryAmbiguous Boolean @default(false)
  // Incrementada por trigger incluso para escrituras SQL; invalida páginas obsoletas.
  customerBookingRevision  BigInt  @default(0)

  customerOperations CustomerOperation[]

  bookings Booking[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // Único por organización, no global — la misma persona puede ser
  // cliente de varias barberías como registros independientes. email
  // opcional para permitir walk-ins sin correo.
  @@unique([organizationId, email])
  @@unique([organizationId, userId])
  @@unique([id, organizationId])
}

model Service {
  id String @id @default(uuid())

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  name String

  description String?

  duration Int

  price Decimal @db.Decimal(65, 2)

  isActive Boolean @default(true)

  professionalServices ProfessionalService[]

  bookings Booking[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Booking {
  id String @id @default(uuid())

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  clientId String

  client Client @relation(fields: [clientId], references: [id])

  professionalId String

  professional Professional @relation(fields: [professionalId], references: [id])

  serviceId String

  service Service @relation(fields: [serviceId], references: [id])

  startTime DateTime

  endTime DateTime

  status BookingStatus @default(PENDING)

  createdAt DateTime @default(now())

  updatedAt       DateTime                @updatedAt
  Invoice         Invoice?
  emailPreference BookingEmailPreference?
  customerOperations CustomerOperation[]

  // The 20260811180000_booking_schedule_exclusion migration also adds a
  // PostgreSQL GiST EXCLUDE constraint for concurrent overlap protection.

  @@unique([id, organizationId], map: "Booking_id_organizationId_key")
  // Acelera GET /bookings (listado filtrado por estado, ordenado por
  // fecha) y las consultas de Analytics (§3 del RFC) sobre el mismo patrón.
  @@index([organizationId, status, createdAt])
  @@index([organizationId, clientId, startTime, id], map: "Booking_customer_page_idx")
}

model CustomerOperation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorUserId    String
  actor          User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  clientId       String
  client         Client       @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  operation      String       @db.VarChar(30)
  keyDigest      String       @db.VarChar(64)
  commandDigest  String       @db.VarChar(64)
  bookingId      String?
  booking        Booking?     @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime     @db.Timestamptz(6)

  @@unique([organizationId, actorUserId, operation, keyDigest], map: "CustomerOperation_context_key")
  @@index([expiresAt])
}

model Payment {
  id               String        @id @default(uuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoiceId        String        @unique
  invoice          Invoice       @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  method           PaymentMethod
  paidAt           DateTime
  recordedByUserId String
  createdAt        DateTime      @default(now())

  @@unique([invoiceId, organizationId], map: "Payment_invoiceId_organizationId_key")
  @@unique([id, organizationId], map: "Payment_id_organizationId_key")
  @@index([organizationId, paidAt, id], map: "Payment_org_paidAt_id_idx")
}

model ProfessionalService {
  id String @id @default(uuid())

  professionalId String

  serviceId String

  professional Professional @relation(fields: [professionalId], references: [id])

  service Service @relation(fields: [serviceId], references: [id])

  price Decimal?

  commission Decimal?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([professionalId, serviceId])
}

model Notification {
  id String @id @default(uuid())

  organizationId String

  userId String?

  title String

  message String

  read Boolean @default(false)

  createdAt DateTime @default(now())
}

// Notificaciones transaccionales C1; separado del registro Notification legacy.
model BookingEmailPreference {
  bookingId               String
  organizationId          String
  booking                 Booking             @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict)
  clientId                String
  client                  Client              @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sequence                Int                 @default(0)
  version                 Int                 @default(0)
  optedIn                 Boolean             @default(false)
  noticeVersion           String?
  recordedAt              DateTime?
  source                  String?
  reviewedContactRevision Int?
  events                  BookingEmailEvent[]

  @@id([bookingId, organizationId])
  @@index([clientId, organizationId])
}

model BookingEmailEvent {
  bookingId         String
  organizationId    String
  sequence          Int
  preference        BookingEmailPreference @relation(fields: [bookingId, organizationId], references: [bookingId, organizationId], onDelete: Restrict)
  kind              String
  bookingStatus     BookingStatus
  startTime         DateTime
  endTime           DateTime
  serviceId         String
  professionalId    String
  contactRevision   Int
  preferenceVersion Int
  createdAt         DateTime               @default(now())
  intent            EmailOutbox?

  @@id([bookingId, organizationId, sequence])
}

model EmailOutbox {
  id                String                @id @default(uuid())
  bookingId         String
  organizationId    String
  eventSequence     Int
  event             BookingEmailEvent     @relation(fields: [bookingId, organizationId, eventSequence], references: [bookingId, organizationId, sequence], onDelete: Restrict)
  channel           String                @default("EMAIL")
  status            String                @default("PENDING")
  reason            String?
  attempts          Int                   @default(0)
  createdAt         DateTime              @default(now())
  expiresAt         DateTime
  nextAttemptAt     DateTime              @default(now())
  retryAfter        DateTime?
  leaseToken        String?
  leaseExpiresAt    DateTime?
  firstDispatchedAt DateTime?
  closedAt          DateTime?
  recipient         String?
  sealedPayload     Json?
  templateVersion   String?
  providerId        String?               @unique
  providerEventAt   DateTime?
  webhooks          EmailWebhookReceipt[]

  @@unique([bookingId, organizationId, eventSequence])
  @@unique([id, organizationId])
  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt, id])
  @@index([closedAt])
}

model EmailWebhookReceipt {
  id             String      @id
  notificationId String
  organizationId String
  notification   EmailOutbox @relation(fields: [notificationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  kind           String
  occurredAt     DateTime
}

model EmailAbuseBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

model EmailChannelControl {
  id        String   @id
  paused    Boolean  @default(false)
  reason    String?
  updatedAt DateTime @default(now())
}

model AuditLog {
  id String @id @default(uuid())

  // NULL se reserva exclusivamente para eventos de seguridad pre-tenant,
  // cuando todavía no existe una Organization autoritativa. Nunca se
  // inventa un tenant para satisfacer el registro de auditoría.
  organizationId String?

  // Sin relación/FK a propósito: un registro de auditoría debe sobrevivir
  // aunque el usuario que hizo la acción deje de existir más adelante —
  // nunca debe bloquear ni depender del ciclo de vida de User. Campo
  // denormalizado simple, no un FK.
  userId String?

  action String

  entity String

  entityId String?

  createdAt DateTime @default(now())
}

model Invoice {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bookingId      String       @unique
  booking        Booking      @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict)
  amount         Decimal      @db.Decimal(65, 2)
  currency       String       @default("DOP")
  payment        Payment?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([bookingId, organizationId], map: "Invoice_bookingId_organizationId_key")
  @@unique([id, organizationId], map: "Invoice_id_organizationId_key")
  @@index([organizationId, createdAt, id], map: "Invoice_org_createdAt_id_idx")
}
