# Desarrollo local. No uses estos valores como secretos de producción.
PORT=3000
HOST=127.0.0.1
# API: rol DML sin ownership/DDL. Provisionar tras migrar usando ops/provision-database-roles.sql.
DATABASE_URL=postgresql://kortek_runtime:replace-with-runtime-secret@localhost:5432/barberflow?schema=public
# Migraciones: mismo nombre de variable en .env.migrations.local (ignorado),
# con usuario kortek_migrator y secreto distinto. Nunca usarlo para arrancar API.
JWT_SECRET=replace-with-a-long-random-local-secret
CORS_ALLOWED_ORIGINS=http://localhost:3001
WHATSAPP_BASE_URL=https://wa.me/

# Clerk se evalúa de forma diferida, pero las rutas Clerk requieren valores
# reales de una instancia Development. Nunca versiones esos valores aquí.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3001
CLERK_JWT_AUDIENCE=
CLERK_INVITATION_REDIRECT_URL=http://localhost:3001/accept-invitation
# Cierre de recuperación: bloquea únicamente las rutas públicas de reserva.
# Activo en todas las réplicas C1 durante recuperación; un binario anterior exige cierre en ingress.
PUBLIC_BOOKING_CLOSED=false
