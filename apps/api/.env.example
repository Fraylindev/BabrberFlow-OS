# Desarrollo local. No uses estos valores como secretos de producción.
PORT=3001
DATABASE_URL=postgresql://barberflow:barberflow_password@localhost:5432/barberflow?schema=public
JWT_SECRET=replace-with-a-long-random-local-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000
WHATSAPP_BASE_URL=https://wa.me/

# Clerk se evalúa de forma diferida, pero las rutas Clerk requieren valores
# reales de una instancia Development. Nunca versiones esos valores aquí.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CLERK_JWT_AUDIENCE=
CLERK_INVITATION_REDIRECT_URL=http://localhost:3000/accept-invitation
